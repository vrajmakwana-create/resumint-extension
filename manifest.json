{
  "manifest_version": 3,
  "name": "Resumint - AI Resume Tailor",
  "version": "1.0.0",
  "description": "Tailor your resume for any job description directly in your browser. Preview, download, and share ATS-optimized resumes.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Resumint Resume Tailor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "logo.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
